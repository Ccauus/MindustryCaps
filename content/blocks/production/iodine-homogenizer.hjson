type: GenericCrafter
name: "Homogenizador de Iodo"
description: "Homogenizador de alta pressão que emulcifica Iodo e Petróleo em Ácido Iódico"
size: 2
health: 200
category: crafting
alwaysUnlocked: false
buildVisibility: shown
solid: true
update: true
destructible: true
rebuildable: true
// custo
requirements: [
	iodine/200
    titanium/125
    metaglass/100
    silicon/100
]
hasItems: true
hasLiquids: true
hasPower: true
itemCapacity: 8
liquidCapacity: 15
// receita
consumes: {
	power: 1.5
	items: [
		iodine/4
	]
    liquids: [
        oil/0.1
    ]
}
craftTime: 120
outputLiquid: iodic-acid/0.15
craftEffect: {
  type: MultiEffect
  effects: [
    ventSteam
    {
      type: WaveEffect
      lifetime: 30
      sizeFrom: 0
      sizeTo: 20
      strokeFrom: 8
      strokeTo: 0
      colorFrom: ce5cff
      colorTo: 7d26cd
      sides: 6
    }
  ]
}
updateEffect: none
updateEffectChance: 0.07
ambientSound: machine
ambientSoundVolume: 0.9
craftSound: hum
craftSoundVolume: 0.9
drawer: {
  type: DrawMulti
  drawers: [
    {
        type: DrawRegion
        suffix: "-bottom"
    }
    {
        type: DrawLiquidTile
        drawLiquid: oil
    }
    {
      type: DrawDefault
    }
    {
      type: DrawGlowRegion
      suffix: "-oilheat"
      color: ffffff
    }
  ]
}