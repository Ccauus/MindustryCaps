type: mech
name: Spreader
description: WIP

speed: 0.5
health: 300
armor: 2
hitSize: 10.5

canBoost: false
faceTarget: true
mechStepParticles: true

outlineColor: 1e1e1e
outlineRadius: 3
mechLegColor: 333333

mechFrontSway: 0.2
stepSound: mechStepSmall

weapons: [
    {
        name: spreader-barrel
        top: false
        layerOffset: -0.001
        rotate: false
